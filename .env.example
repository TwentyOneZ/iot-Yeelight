# Tuya Cloud
TUYA_ACCESS_KEY=your-tuya-access-id
TUYA_SECRET_KEY=your-tuya-access-secret
TUYA_DEVICE_ID=your-tuya-device-id
TUYA_API_BASE_URL=https://openapi.tuyaus.com

# Tuya Message Service
# Use the same region as your Tuya Cloud project: US, EU, CN, IN, or SG.
TUYA_MESSAGE_REGION=US
TUYA_MESSAGE_ENV=PROD
TUYA_MESSAGE_ENABLED=true
TUYA_MESSAGE_DEBUG=false

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883

# Yeelight
YEELIGHT_IP=192.168.0.10
YEELIGHT_PORT=55443

# Optional Tuya IR remote support
TUYA_INFRARED_ID=your-tuya-ir-device-id
TUYA_REMOTE_ID=your-tuya-remote-id
TUYA_REMOTE_CATEGORY_ID=2
